# Copy to .env.local and fill in (scripts/update.sh creates .env.local for you).
# .env.local is git-ignored; this repo is PUBLIC, so real values never go in
# this file.

# TEMPORARY local mode: the database lives in site/.local-db/ (PGlite files),
# login is local (password + authenticator code). No Docker or Supabase needed.
# Remove these two lines to use Supabase (the settings below).
DB_MODE=local
# Signs the local session cookie. At least 32 random characters, e.g.
# `openssl rand -hex 32`.
LOCAL_AUTH_SECRET=replace-with-at-least-32-random-characters
# Optional separate key for media downloads and upload tickets (32+ characters).
# When blank, uses LOCAL_AUTH_SECRET or SUPABASE_SERVICE_ROLE_KEY.
MEDIA_SIGNING_SECRET=

# Local Supabase for this app (`supabase start` in site/, then `supabase status`).
# Ignored while DB_MODE=local.
# Never the website's Supabase project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key-from-supabase-status
# Server only. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-from-supabase-status

# Who may sign in to /admin (comma separated). The account must also exist in
# Supabase Auth (npm run admin:create) and enrol TOTP on first login.
ADMIN_EMAILS=admin@example.com

# Shared with the worker. At least 32 characters, e.g. `openssl rand -hex 32`.
WORKER_TOKEN=replace-with-at-least-32-random-characters

# Shared with n8n (its Header Auth credential). Opens /api/automation/social/v1:
# create generation requests, read events, log runs. It cannot approve or
# publish. At least 32 characters, e.g. `openssl rand -hex 32`; blank = that API
# answers 503. Use a different value than WORKER_TOKEN.
N8N_AUTOMATION_TOKEN=

# Kill switch: claims return nothing unless this is exactly "true".
SOCIAL_PUBLISHING_ENABLED=false

# Operator company name(s), comma separated, for the "no legal name" check.
# Set only in .env.local, never here.
SOCIAL_LEGAL_NAMES=

# Used by the fake worker / fake generator scripts.
SITE_BASE_URL=http://localhost:3000
