# Site connection (mock-site on localhost until the real site exists)
SITE_BASE_URL=http://localhost:3000
WORKER_TOKEN=generate-a-random-token-min-32-chars
WORKER_ID=worker-local-01

# Postiz
POSTIZ_BASE_URL=http://localhost:4007
POSTIZ_API_KEY=get-from-postiz-settings-after-setup

# AI drafting. Set at least one key, or the generator loop is skipped and only
# delivery + sync run. Left blank = unset.
# The admin picks the model per request on the Generate screen ("Model AI");
# the settings below are only the default for "Implicit". A pick whose key is
# missing here fails that request with AI_NOT_CONFIGURED.
# GENERATOR_PROVIDER picks the default (claude or gemini); blank = whichever key
# is set, Claude first if both are.
GENERATOR_PROVIDER=

# Claude: key from https://console.anthropic.com (starts with sk-ant-)
ANTHROPIC_API_KEY=
GENERATOR_MODEL=claude-opus-5-5
GENERATOR_EFFORT=medium
GENERATION_HEARTBEAT_MS=120000

# Gemini: key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Behavior
WORKER_DRY_RUN=true
DELIVERY_LOOP_INTERVAL_MS=30000
GENERATION_LOOP_INTERVAL_MS=15000
SYNC_LOOP_INTERVAL_MS=900000
