# Postiz secrets (local dev stack, local/docker-compose.yml)
POSTIZ_JWT_SECRET=generate-a-random-32-char-string
DISABLE_REGISTRATION=false
# Set to true after creating the first user

# Provider credentials (fill as you connect each one; Postiz also lets you
# add these through its own UI under Settings > Integrations)
# X_API_KEY=
# X_API_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
