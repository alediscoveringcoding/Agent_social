# This repo is public: never commit secrets.
.env*
!.env.example

# dependencies and build output
# node_modules at any depth, as a folder or a symlink (no trailing slash, so a
# linked node_modules is caught too). Also enforced by .githooks/pre-commit and
# .github/workflows/no-node-modules.yml, which catch a forced `git add -f`.
node_modules
.next/
out/
dist/
build/
coverage/
*.tsbuildinfo

# logs
*.log
npm-debug.log*

# local data and backups
*.dump
*.sql.gz
backups/

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
